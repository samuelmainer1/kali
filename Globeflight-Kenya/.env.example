# Server only. Keep the real keys out of this public repository.
RESEND_API_KEY=
GROQ_API_KEY=
MAIL_FROM=Globeflight Kenya <cs@globeflight.co.ke>
MAIL_NOTIFY_TO=cs@globeflight.co.ke

# Optional. Leave SITE_URL empty so the sitemap uses the address visitors use.
# A subdomain and globeflight.co.ke then each get their own links automatically.
# Set WEB_ROOT only when the website files live in a different folder, such as public_html.
SITE_URL=
WEB_ROOT=
